      "id": "a9559e69-9f3a-4602-bc56-b7aabd79a952",
      "name": "Check Website",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        -336,
        160
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst processed = [];\n\nfor (const item of items) {\n  const json = item.json;\n  const body = json.data || json.body || \"\";\n  const statusCode = json.statusCode;\n  \n  let isHealthy = false;\n  let reason = \"\";\n  \n  const bodyLower = typeof body === 'string' ? body.toLowerCase() : JSON.stringify(body).toLowerCase();\n  const hasKeyword = bodyLower.includes(\"KEYWORD_#1\") || bodyLower.includes(\"KEYWORD_#2\") || bodyLower.includes(\"KEYWORD_#3\");\n  \n  if (statusCode === 200 && hasKeyword) {\n    isHealthy = true;\n  } else if (statusCode !== 200) {\n    isHealthy = false;\n    reason = `HTTP status code is ${statusCode || 'Unknown/Timeout'} instead of 200.`;\n  } else if (!hasKeyword) {\n    isHealthy = false;\n    reason = \"Website is up, but readability check failed (keywords like 'Cyber Resonance', 'Scalable Security', or 'Software' not found on the page).\";\n  }\n  \n  processed.push({\n    json: {\n      isHealthy,\n      statusCode: statusCode || null,\n      keywordFound: hasKeyword,\n      reason,\n      timestamp: new Date().toISOString(),\n      url: \"YOUR_URL_HERE\"\n    }\n  });\n}\n\nreturn processed;"
      },
      "id": "fffe87d3-6570-4cef-aaae-76babb0fbd3b",
      "name": "Evaluate Health",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -112,
        160
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "health-check-healthy",
              "leftValue": "={{ $json.isHealthy }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "dbace8f2-f9e9-4eb8-8ceb-476e52c0beeb",
      "name": "Is Healthy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        144,
