      "id": "75bdbf2f-9f1d-4ad1-afab-1e305bfd557c",
      "name": "Run DNS Diagnostics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        352,
        288
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const dnsData = $input.first()?.json;\nconst healthData = $('Evaluate Health').first().json;\n\nlet dnsStatus = \"Unknown\";\nlet dnsIPs = [];\n\nif (dnsData && dnsData.Answer) {\n  dnsStatus = \"RESOLVED\";\n  dnsIPs = dnsData.Answer.map(ans => ans.data);\n} else if (dnsData && dnsData.Status === 3) {\n  dnsStatus = \"NXDOMAIN (Domain does not exist)\";\n} else {\n  dnsStatus = \"FAILED TO RESOLVE\";\n}\n\nreturn [{\n  json: {\n    ...healthData,\n    dnsStatus,\n    dnsIPs,\n    diagnosticSummary: `DNS Check: ${dnsStatus} ${dnsIPs.length > 0 ? '(' + dnsIPs.join(', ') + ')' : ''}`\n  }\n}];"
      },
      "id": "352760f8-a266-4727-a066-40dd4f24fff0",
      "name": "Process Diagnostics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        576,
        288
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst processed = [];\n\n// Retrieve static data for state management\nconst staticData = $getWorkflowStaticData('global');\nconst previousState = staticData.previousState || 'up';\n\nfor (const item of items) {\n  const json = item.json;\n  const currentState = json.isHealthy ? 'up' : 'down';\n  \n  let triggerAlert = false;\n  let alertType = '';\n  \n  if (currentState === 'down' && previousState === 'up') {\n    triggerAlert = true;\n    alertType = 'down';\n    staticData.previousState = 'down';\n  } else if (currentState === 'up' && previousState === 'down') {\n    triggerAlert = true;\n    alertType = 'recovery';\n    staticData.previousState = 'up';\n  } else {\n    triggerAlert = false;\n  }\n  \n  processed.push({\n    json: {\n      ...json,\n      previousState,\n      currentState,\n      triggerAlert,\n      alertType\n    }\n  });\n}\n\nreturn processed;"
      },
